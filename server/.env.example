APP_ID=your-app-id
APP_SECRET=your-app-secret
SIGNING_KEY=your-hex-encoded-signing-key
APP_STORE_URL=https://app-store-api.channel.io
PORT=3000

# Local debugging only. Never enable this in production.
SKIP_SIGNATURE_VERIFICATION=false

# Set gemini to enable natural-language analysis; rule keeps offline behavior.
MODEL_PROVIDER=rule
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Optional presentation audio. For Wrangler put these in .dev.vars / Worker secrets.
# DEMO_TTS_TOKEN is a separate random presenter token, NOT the ElevenLabs key.
DEMO_TTS_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_STUDENT_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_ASSISTANT_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Search only one source. Defaults to real. Set demo explicitly for local demonstrations.
FAILFAIR_CASE_SOURCE=real
